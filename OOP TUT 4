#include <iostream>
using namespace std;
class Complex {
float real, imag;
public:
void input() {
cin >> real >> imag;
}
Complex add(Complex c) {
Complex temp;
temp.real = real + c.real;
temp.imag = imag + c.imag;
return temp;
}
Complex subtract(Complex c) {
Complex temp;
temp.real = real - c.real;
temp.imag = imag - c.imag;
return temp;
}
void display() {
cout << real << " + " << imag << "i";
}
};

int main() {
Complex c1, c2, c3, sum, result;
cout << "Enter first 2 numbers = ";
c1.input();
cout << "Enter second 2 numbers = ";
c2.input();
cout << "Enter third 2 numbers = ";
c3.input();
sum = c1.add(c2);
result = sum.subtract(c3);
cout << "\nResult = ";
result.display();
return
}
