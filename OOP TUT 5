#include <iostream>
using namespace std;
class Calculator {
public:
// calculate() for addition of two numbers
int calculate(int a, int b) {
return a + b;
}
// calculate() for subtraction of two numbers
int calculate(int a, int b, char operation) {
if (operation == '-')
return a - b;
else
return 0;
}
};
int main() {
Calculator obj;
int a, b;
cout << "Enter two numbers: ";
cin >> a >> b;
cout << "Addition = " << obj.calculate(a, b) << endl;
cout << "Subtraction = " << obj.calculate(a, b, '-') << endl;

return 0;
}
